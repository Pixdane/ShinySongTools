;; Babashka tasks (docs/tasks.md).

{:paths ["tools"]

 :tasks
 {bundle
  {:doc "Bundle 操作。用法: bb bundle build|status|patch|restore|selftest"
   :requires ([cheshire.core :as json]
              [bundle-ops :as bo])
   :task
   (let [[command & args] *command-line-args*]
     (case command
       "build"
       (do
         (apply shell "zig build bundle" args)
         (let [manifest (json/parse-string (slurp "build/AKInterface.bundle.manifest.json"))]
           (println)
           (println "Bundle built successfully")
           (println)
           (doseq [[label value]
                   [["Artifact" "build/AKInterface.bundle"]
                    ["Executable" (get-in manifest ["bundle" "executable"])]
                    ["Exec SHA" (get-in manifest ["bundle" "executable_sha256"])]
                    ["Target" (get-in manifest ["bundle" "target"])]
                    ["PlayTools" (get-in manifest ["upstream" "commit"])]
                    ["Patch" (get-in manifest ["patch" "sha256"])]
                    ["Signature" "ad-hoc, verified"]
                    ["Manifest" "build/AKInterface.bundle.manifest.json"]]]
             (println (clojure.core/format "%-12s %s" label value)))))

       "status"
       (doseq [line (bo/status-lines (bo/status (bo/game-ctx!)))]
         (println line))

       "patch"
       (let [opts (into {}
                        (map (fn [[k v]] [k v]))
                        (partition 2 args))
             result (bo/patch! (bo/game-ctx!)
                               {:expected-executable-sha
                                (get opts "--expected-executable-sha")
                                :expected-installed-executable-sha
                                (get opts "--expected-installed-executable-sha")})]
         (println)
         (println (if (:idempotent result)
                    "Bundle already installed (idempotent)"
                    "Bundle patched successfully"))
         (println)
         (println (clojure.core/format "%-17s %s" "Installed exec" (:executable-sha result)))
         (println (clojure.core/format "%-17s %s" "First patch" (str (:first-patch result)))))

       "restore"
       (let [result (bo/restore! (bo/game-ctx!))]
         (println)
         (println (if (:idempotent result)
                    "Bundle already clean (idempotent)"
                    "Bundle restored to baseline successfully")))

       "selftest"
       (do
         (bo/selftest!)
         (println)
         (println "Bundle selftest OK (sandbox lifecycle verified)"))

       (throw
        (ex-info "用法: bb bundle build|status|patch|restore|selftest"
                 {:args *command-line-args*}))))}

  debug
  {:doc "调用 debug socket。用法: bb debug [--socket <path>] <method> [json-params]

内置 method：runtime.plugins / runtime.gates / runtime.info，
插件注册的 topic（如 fps.get / fps.set / fps.probe）。
socket 默认从 local.edn 的游戏 .app 推导，或用 --socket 显式指定。
交互式 REPL：bb --init tools/debug_client.clj -r"
   :requires ([cheshire.core :as json]
              [debug-client :as dc])
   :task
   (let [args (vec *command-line-args*)
         [socket args] (if (= "--socket" (first args))
                         [(second args) (vec (drop 2 args))]
                         [nil args])
         method (first args)
         params (if-let [raw (second args)]
                  (json/parse-string raw)
                  {})]
     (when (nil? method)
       (println "用法: bb debug [--socket <path>] <method> [json-params]")
       (println "method 例: runtime.plugins / runtime.gates / runtime.info / fps.set")
       (System/exit 1))
     (let [response (dc/call socket method params)]
       (println (json/generate-string response {:pretty true}))))}

  translation
  {:doc "翻译样板。用法: bb translation generate|check|apply|selftest"
   :requires ([translation-templates :as tt])
   :task
   (let [[command & args] *command-line-args*]
     (case command
       "generate"
       (let [[dump out-dir] args
             result (tt/generate! (or dump tt/default-dump)
                                  (or out-dir tt/default-output-dir))]
         (println "Translation templates generated")
         (doseq [[label key] [["Catalog" :catalog]
                              ["Bindings" :bindings]
                              ["Slots" :slots]
                              ["Text units" :units]
                              ["Entity units" :entities]
                              ["Templates" :templates]
                              ["Pending" :pending]
                              ["Source digest" :source-digest]]]
           (println (clojure.core/format "%-14s %s" label (get result key)))))

       "check"
       (let [[dump out-dir] args
             result (tt/check! (or dump tt/default-dump)
                               (or out-dir tt/default-output-dir))]
         (println "Translation templates valid")
         (doseq [[label key] [["Slots" :slots]
                              ["Units" :units]
                              ["Translated" :translated]
                              ["Pending" :pending]]]
           (println (clojure.core/format "%-12s %s" label (get result key)))))

       "apply"
       (let [[dump out-dir output] args
             result (tt/apply! (or dump tt/default-dump)
                               (or out-dir tt/default-output-dir)
                               (or output tt/default-applied))]
         (println "Translation dictionary materialized")
         (println (clojure.core/format "%-12s %s" "Output" (:output result)))
         (println (clojure.core/format "%-12s %s" "Slots" (:slots result))))

       "selftest"
       (do (tt/selftest!) (println "Translation template selftest OK"))

       (throw
        (ex-info "用法: bb translation generate|check|apply|selftest"
                 {:args *command-line-args*}))))}}}
